<Application x:Class="Aac.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- High-contrast palette, readable from about four feet. -->
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <SolidColorBrush x:Key="Fg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="Focus" Color="#7CFF4F"/>
        <SolidColorBrush x:Key="FocusFill" Color="#2F7D32"/>
        <SolidColorBrush x:Key="SpeakFill" Color="#0E7A2A"/>
        <SolidColorBrush x:Key="MessageBorder" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="CommandFill" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="LetterFill" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="QuickFill" Color="#5A3300"/>
        <SolidColorBrush x:Key="SuggestFill" Color="#0F2E4A"/>
        <SolidColorBrush x:Key="PredictFill" Color="#183A1C"/>
        <SolidColorBrush x:Key="PinnedFill" Color="#6B1414"/>
        <SolidColorBrush x:Key="SplitKey" Color="#FF7A1A"/>
        <SolidColorBrush x:Key="MenuFill" Color="#1C3350"/>
        <SolidColorBrush x:Key="MenuBorder" Color="#3E6A9E"/>
        <!-- Buttons that move the Itch figure: a blue of their own, so they read as tools rather than words. -->
        <!-- The words that replace the urgent strip while Itch is open; App.xaml.cs swaps these for the look chosen in Settings. -->
        <SolidColorBrush x:Key="SpokenFill" Color="#15405E"/>
        <SolidColorBrush x:Key="SpokenBorder" Color="#D9534F"/>
        <!-- Each kind of movement of the Itch figure has its own colour: turn and the views are blue (below). -->
        <SolidColorBrush x:Key="TiltFill" Color="#0F4A47"/>
        <SolidColorBrush x:Key="TiltBorder" Color="#3FB5A8"/>
        <SolidColorBrush x:Key="SlideFill" Color="#3B2A66"/>
        <SolidColorBrush x:Key="SlideBorder" Color="#9B7FE0"/>
        <SolidColorBrush x:Key="ZoomFill" Color="#4A4310"/>
        <SolidColorBrush x:Key="ZoomBorder" Color="#D2BC3E"/>
        <SolidColorBrush x:Key="EditRed" Color="#E02424"/>
        <!-- Button edit mode: a yellow and black diagonal "construction" border on every button that can be changed. -->
        <LinearGradientBrush x:Key="HazardStripes" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="18,18">
            <GradientStop Color="#FFD400" Offset="0"/>
            <GradientStop Color="#FFD400" Offset="0.5"/>
            <GradientStop Color="#111111" Offset="0.5"/>
            <GradientStop Color="#111111" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ToolFill" Color="#15405E"/>
        <SolidColorBrush x:Key="ToolBorder" Color="#4A8BD0"/>
        <SolidColorBrush x:Key="ChipFill" Color="#26313D"/>
        <SolidColorBrush x:Key="OnFill" Color="#2F5F95"/>
        <SolidColorBrush x:Key="OnBorder" Color="#8DB8EA"/>
        <SolidColorBrush x:Key="SpeakOutline" Color="#2E9E4A"/>
        <SolidColorBrush x:Key="StopFill" Color="#C41E1E"/>
        <SolidColorBrush x:Key="StopBorder" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="HideFill" Color="#E8B400"/>
        <SolidColorBrush x:Key="HideBorder" Color="#FFE27A"/>
        <SolidColorBrush x:Key="NoticeFill" Color="#3A2A00"/>
    </Application.Resources>
</Application>
