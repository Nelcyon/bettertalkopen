<Application x:Class="Aac.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- High-contrast palette, readable from about four feet. -->
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <SolidColorBrush x:Key="Fg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="Focus" Color="#7CFF4F"/>
        <SolidColorBrush x:Key="FocusFill" Color="#2F7D32"/>
        <SolidColorBrush x:Key="SpeakFill" Color="#0E7A2A"/>
        <SolidColorBrush x:Key="MessageBorder" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="CommandFill" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="LetterFill" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="QuickFill" Color="#5A3300"/>
        <SolidColorBrush x:Key="SuggestFill" Color="#0F2E4A"/>
        <SolidColorBrush x:Key="PredictFill" Color="#183A1C"/>
        <SolidColorBrush x:Key="PinnedFill" Color="#6B1414"/>
        <SolidColorBrush x:Key="SplitKey" Color="#FF7A1A"/>
        <SolidColorBrush x:Key="MenuFill" Color="#1C3350"/>
        <SolidColorBrush x:Key="MenuBorder" Color="#3E6A9E"/>
        <SolidColorBrush x:Key="ChipFill" Color="#26313D"/>
        <SolidColorBrush x:Key="OnFill" Color="#2F5F95"/>
        <SolidColorBrush x:Key="OnBorder" Color="#8DB8EA"/>
        <SolidColorBrush x:Key="SpeakOutline" Color="#2E9E4A"/>
        <SolidColorBrush x:Key="StopFill" Color="#C41E1E"/>
        <SolidColorBrush x:Key="StopBorder" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="HideFill" Color="#E8B400"/>
        <SolidColorBrush x:Key="HideBorder" Color="#FFE27A"/>
        <SolidColorBrush x:Key="NoticeFill" Color="#3A2A00"/>
    </Application.Resources>
</Application>
