<Window x:Class="Aac.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:board="clr-namespace:Aac.Core.Board;assembly=Aac.Core"
        xmlns:local="clr-namespace:Aac.App"
        Title="BetterTalk" Width="1100" Height="700" MinWidth="360" MinHeight="260"
        AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" WindowStartupLocation="Manual" ResizeMode="CanResize"
        WindowStyle="None">
    <!-- No title bar: the window sits flush in the top-left corner. Its edges can still be dragged to resize
         (unless the size is locked); Alt+F4, Hide, the tray and any hotkey set in Settings hide it. -->
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome" CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- The buttons on the edit-mode and move-mode labels: dark and rounded, never Windows' plain white ones. -->
        <Style x:Key="BadgeButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0D1624"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1F3556"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="{StaticResource CommandFill}"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                            <!-- A brief green flash when the button is pressed (see MainWindow.Flash). -->
                            <Border x:Name="FlashLayer" CornerRadius="10" Background="{StaticResource Focus}" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Cell.Kind}" Value="{x:Static board:CellKind.Letter}">
                    <Setter Property="Background" Value="{StaticResource LetterFill}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Kind}" Value="{x:Static board:CellKind.QuickPhrase}">
                    <Setter Property="Background" Value="{StaticResource QuickFill}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Kind}" Value="{x:Static board:CellKind.Pinned}">
                    <Setter Property="Background" Value="{StaticResource PinnedFill}"/>
                    <Setter Property="FontSize" Value="24"/>
                    <Setter Property="Margin" Value="4,2"/>
                    <Setter Property="Padding" Value="2,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Kind}" Value="{x:Static board:CellKind.Candidate}">
                    <Setter Property="Background" Value="{StaticResource SuggestFill}"/>
                </DataTrigger>
                <!-- Menu buttons (beside the space bar) stand apart from the letter keys. -->
                <DataTrigger Binding="{Binding Cell.Kind}" Value="{x:Static board:CellKind.Menu}">
                    <Setter Property="Background" Value="{StaticResource MenuFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Kind}" Value="{x:Static board:CellKind.Prediction}">
                    <Setter Property="Background" Value="{StaticResource PredictFill}"/>
                </DataTrigger>
                <!-- Moving the figure: blue tools. Words said out loud (the top strip while Itch is open): the look chosen in
                     Settings (SpokenFill / SpokenBorder), sized like the urgent phrases they replace. -->
                <DataTrigger Binding="{Binding Cell.Kind}" Value="{x:Static board:CellKind.Tool}">
                    <Setter Property="Background" Value="{StaticResource ToolFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ToolBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Tone}" Value="tilt">
                    <Setter Property="Background" Value="{StaticResource TiltFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource TiltBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Tone}" Value="slide">
                    <Setter Property="Background" Value="{StaticResource SlideFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SlideBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Tone}" Value="zoom">
                    <Setter Property="Background" Value="{StaticResource ZoomFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ZoomBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Kind}" Value="{x:Static board:CellKind.Spoken}">
                    <Setter Property="Background" Value="{StaticResource SpokenFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SpokenBorder}"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="FontSize" Value="24"/>
                    <Setter Property="Margin" Value="4,2"/>
                    <Setter Property="Padding" Value="2,0"/>
                </DataTrigger>
                <!-- The two halves of a split key (backspace: letter | word) share one orange outline. -->
                <DataTrigger Binding="{Binding Cell.Part}" Value="{x:Static board:KeyPart.Start}">
                    <Setter Property="BorderBrush" Value="{StaticResource SplitKey}"/>
                    <Setter Property="BorderThickness" Value="3,3,1,3"/>
                    <Setter Property="Margin" Value="5,5,0,5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Part}" Value="{x:Static board:KeyPart.End}">
                    <Setter Property="BorderBrush" Value="{StaticResource SplitKey}"/>
                    <Setter Property="BorderThickness" Value="1,3,3,3"/>
                    <Setter Property="Margin" Value="0,5,5,5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Kind}" Value="{x:Static board:CellKind.Category}">
                    <Setter Property="Background" Value="{StaticResource ChipFill}"/>
                </DataTrigger>
                <!-- The open drawer's button and the chosen phrase category are lit. -->
                <DataTrigger Binding="{Binding Cell.IsOn}" Value="True">
                    <Setter Property="Background" Value="{StaticResource OnFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OnBorder}"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>
                <!-- Speak and its Stop segment are one key with a green outline. -->
                <DataTrigger Binding="{Binding Cell.Command}" Value="{x:Static board:CommandId.Speak}">
                    <Setter Property="BorderBrush" Value="{StaticResource SpeakOutline}"/>
                </DataTrigger>
                <!-- Stop is always red so the user can find it: dimmed while nothing is being said, bright while speaking. -->
                <DataTrigger Binding="{Binding Cell.Command}" Value="{x:Static board:CommandId.StopVoice}">
                    <Setter Property="BorderBrush" Value="{StaticResource SpeakOutline}"/>
                    <Setter Property="Background" Value="{StaticResource StopFill}"/>
                </DataTrigger>
                <!-- Hide ends the bottom row, at the bottom-right corner: a yellow button with dark text. -->
                <DataTrigger Binding="{Binding Cell.Command}" Value="{x:Static board:CommandId.HideWindow}">
                    <Setter Property="Background" Value="{StaticResource HideFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource HideBorder}"/>
                    <Setter Property="Foreground" Value="#111111"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <!-- Button edit mode: the buttons that can be changed (they carry the "tap to change" hint) and the ＋ Add
                     buttons get a yellow and black diagonal border, like a construction sign. -->
                <DataTrigger Binding="{Binding Cell.Hint}" Value="✎ tap to change">
                    <Setter Property="BorderBrush" Value="{StaticResource HazardStripes}"/>
                    <Setter Property="BorderThickness" Value="6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Command}" Value="{x:Static board:CommandId.AddPhrase}">
                    <Setter Property="BorderBrush" Value="{StaticResource HazardStripes}"/>
                    <Setter Property="BorderThickness" Value="6"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Cell.Command}" Value="{x:Static board:CommandId.StopVoice}"/>
                        <Condition Binding="{Binding Cell.IsEnabled}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource StopFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StopBorder}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Cell.Command}" Value="{x:Static board:CommandId.Speak}"/>
                        <Condition Binding="{Binding Cell.IsEnabled}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SpeakFill}"/>
                </MultiDataTrigger>
                <!-- Focus last so it always wins: a thick lime frame, lighter green fill and bold text. Predicted
                     words are a softer, darker green with no frame, so the two never look alike. -->
                <!-- Only shown while the user is moving with arrow keys / switches; with the mouse or eye tracker a
                     press just flashes the button and nothing stays highlighted. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFocused}" Value="True"/>
                        <Condition Binding="{Binding ShowFocusFrame, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource Focus}"/>
                    <Setter Property="BorderThickness" Value="7"/>
                    <Setter Property="Background" Value="{StaticResource FocusFill}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Opacity" Value="1"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One board target. Shared by the board and the side panel. -->
        <DataTemplate x:Key="CellTemplate">
            <Button Style="{StaticResource CellButton}" Tag="{Binding Cell.Id}" Click="Cell_Click"
                    PreviewMouseLeftButtonDown="Cell_PressStart" PreviewMouseLeftButtonUp="Cell_PressEnd" MouseLeave="Cell_PressEnd"
                    AutomationProperties.Name="{Binding Cell.Label}" AutomationProperties.HelpText="{Binding Cell.Hint}">
                <Grid x:Name="CellContent">
                    <!-- Text cells: the label as large as fits, centred, with any hint beneath. -->
                    <local:FitText x:Name="TextContent" Text="{Binding Cell.Label}" Hint="{Binding Cell.Hint}"/>
                    <!-- Icon cells: a large symbol with a one-word caption. -->
                    <Viewbox x:Name="IconContent" Visibility="Collapsed" Stretch="Uniform" StretchDirection="Both" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding Cell.Icon}" FontFamily="Segoe UI Symbol, Segoe UI Emoji" FontSize="54"
                                   TextAlignment="Center" LineHeight="58" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock x:Name="IconCaption" Text="{Binding Cell.ShownCaption}" FontSize="26" Opacity="0.85"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    </Viewbox>
                    <!-- Delete word: a backspace-key outline with "word" inside. -->
                    <Viewbox x:Name="WordBackspace" Visibility="Collapsed" Stretch="Uniform" StretchDirection="Both" Margin="6,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="120" Height="56">
                            <Path Data="M 22,2 L 118,2 L 118,54 L 22,54 L 2,28 Z" Stroke="{StaticResource Fg}" StrokeThickness="4"
                                  StrokeLineJoin="Round"/>
                            <TextBlock Text="word" FontSize="28" FontWeight="SemiBold" Margin="18,0,0,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Cell.Icon, Converter={x:Static local:IsSetConverter.Instance}}" Value="True">
                    <Setter TargetName="TextContent" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="IconContent" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.ShownCaption, Converter={x:Static local:IsSetConverter.Instance}}" Value="False">
                    <Setter TargetName="IconCaption" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cell.Command}" Value="{x:Static board:CommandId.DeleteWord}">
                    <Setter TargetName="TextContent" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="IconContent" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="WordBackspace" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Rows are buttons, except the Itch view row (the 3D figure) and titled rows (a heading over a panel's buttons). -->
        <local:RowTemplateSelector x:Key="RowTemplates">
            <local:RowTemplateSelector.Buttons>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Cells}" Focusable="False" ItemTemplate="{StaticResource CellTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:BoardCellsPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DataTemplate>
            </local:RowTemplateSelector.Buttons>
            <!-- Itch: the 3D figure takes this row's place. -->
            <local:RowTemplateSelector.ItchFigure>
                <DataTemplate>
                    <local:ItchViewHost/>
                </DataTemplate>
            </local:RowTemplateSelector.ItchFigure>
            <!-- A heading: what the buttons under it do, in a line, with a line of explanation when it needs one. -->
            <local:RowTemplateSelector.Title>
                <DataTemplate>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource Fg}"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="18" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                                       Visibility="{Binding Subtitle, Converter={x:Static local:VisibleIfSet.Instance}}"/>
                        </StackPanel>
                    </Viewbox>
                </DataTemplate>
            </local:RowTemplateSelector.Title>
        </local:RowTemplateSelector>
    </Window.Resources>

    <!-- Fixed layout: the board keeps its size and position whatever is typed or suggested. Status and
         message sit in fixed-height strips at the bottom; sentence options slide over the board's right side. -->
    <Grid x:Name="Root" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- The keyboard is in the middle column. The Itch panels take the columns on the side the window grows
             toward: the right for a window anchored at the left of the screen, the left for one anchored at the
             right (see MainWindow.MirrorLayout). -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Itch: a full-height panel beside the keyboard holding just the figure. The controls (Move the figure) are a
             panel of their own beyond it. With the UI unlocked (move mode) either can be dragged anywhere, into a window
             of its own (see MainWindow.SyncPanels); a cover over each (ItchCoverHost, MoveCoverHost) then takes the presses. -->
        <Border x:Name="ItchPanel" Grid.Column="3" Grid.RowSpan="2" Visibility="Collapsed" Margin="8,0,0,0" Background="{StaticResource Bg}"
                BorderBrush="{StaticResource MenuBorder}" BorderThickness="2" CornerRadius="12" Padding="2">
            <Grid>
                <ItemsControl x:Name="ItchBoard" Focusable="False" ItemTemplateSelector="{StaticResource RowTemplates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:BoardRowsPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ContentControl x:Name="ItchCoverHost" Focusable="False"/>
            </Grid>
        </Border>

        <!-- The controls: a button for every movement of the figure, in a panel beyond the figure that the controller icon
             over the figure's corner folds away and back. As tall as its buttons need (MainWindow.FitMovePanel). -->
        <Border x:Name="MovePanel" Grid.Column="4" Grid.RowSpan="2" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Top"
                Background="{StaticResource Bg}" BorderBrush="{StaticResource MenuBorder}" BorderThickness="2" CornerRadius="12" Padding="2">
            <Grid>
                <ItemsControl x:Name="MoveBoard" Focusable="False" ItemTemplateSelector="{StaticResource RowTemplates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:BoardRowsPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ContentControl x:Name="MoveCoverHost" Focusable="False"/>
            </Grid>
        </Border>

        <!-- The window itself is see-through: only the keyboard (this background) and the panels are drawn, so a panel is
             exactly as big as what is in it and nothing stretches beside or below it. -->
        <Border x:Name="KeyboardBack" Grid.Column="2" Grid.RowSpan="2" Margin="-14" Panel.ZIndex="-1"
                Background="{StaticResource Bg}" BorderBrush="#333333" BorderThickness="1"/>

        <!-- One screen: urgent strip, word suggestions, keyboard and (below it) the open drawer. Itch opens as
             a full-height panel on the right; the window grows wider for it, so nothing on the left moves. -->
        <Grid x:Name="BoardHost" Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
            <ItemsControl x:Name="Board" Focusable="False" ItemTemplateSelector="{StaticResource RowTemplates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:BoardRowsPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

        </Grid>

        <!-- The message, at the bottom in a fixed-height box: longer text shows more lines, then scrolls to the newest. -->
        <Border x:Name="MessagePanel" Grid.Row="1" Grid.Column="2" CornerRadius="12" Padding="16,10" BorderThickness="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#111111"/>
                    <Setter Property="BorderBrush" Value="{StaticResource MessageBorder}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource SpeakFill}"/>
                            <Setter Property="Background" Value="#06210D"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <TextBlock x:Name="DraftText" TextWrapping="Wrap"
                               FontWeight="SemiBold" AutomationProperties.Name="Message"/>
                </ScrollViewer>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value=""/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                                    <Setter Property="Text" Value="🔊 SPEAKING"/>
                                    <Setter Property="Foreground" Value="{StaticResource Focus}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <!-- Problems (voice missing, settings unreadable, a crash) show here for a few seconds, over the message box. -->
        <Border x:Name="NoticeBanner" Grid.Row="1" Grid.Column="2" Visibility="Collapsed" CornerRadius="12" Padding="16,10"
                Background="{StaticResource NoticeFill}" BorderBrush="{StaticResource Focus}" BorderThickness="3" IsHitTestVisible="False">
            <TextBlock x:Name="NoticeText" FontSize="24" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"/>
        </Border>

        <!-- Button edit mode can never be forgotten: a red frame round the whole window, and a label on its bottom edge
             (over the message box's border only, not its text) with a Done button, so there is always a way out. -->
        <Border x:Name="EditFrame" Grid.RowSpan="2" Grid.ColumnSpan="5" Margin="-14" BorderBrush="{StaticResource EditRed}" BorderThickness="6"
                IsHitTestVisible="False" Panel.ZIndex="50">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EditMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Border x:Name="EditBadge" Grid.RowSpan="2" Grid.ColumnSpan="5" Margin="0,0,0,-14" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="{StaticResource EditRed}" CornerRadius="10,10,0,0" Padding="16,2,6,2" Panel.ZIndex="51">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EditMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="BUTTON EDIT MODE" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="tap a striped button to change its words or its place" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="12,0,14,0"/>
                <Button Style="{StaticResource BadgeButton}" Content="Done editing" FontSize="16" FontWeight="Bold" Padding="16,2" Click="EditDone_Click"/>
            </StackPanel>
        </Border>
        <!-- Move mode (UI unlocked): a label on the bottom edge with Lock UI, so there is always a way back. -->
        <Border x:Name="MoveBadge" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,0,-14" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="#2F5F95" BorderBrush="#7CC4FF" BorderThickness="2,2,2,0" CornerRadius="10,10,0,0" Padding="16,2,6,2" Panel.ZIndex="51" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="UI UNLOCKED" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="drag a panel to move it · drag its edge to resize" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="12,0,14,0"/>
                <Button Style="{StaticResource BadgeButton}" Content="Put panels back" FontSize="16" Padding="12,2" Margin="0,0,6,0" Click="PutBack_Click"/>
                <Button Style="{StaticResource BadgeButton}" Content="🔒 Lock UI" FontSize="16" FontWeight="Bold" Padding="16,2" Click="LockUi_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
