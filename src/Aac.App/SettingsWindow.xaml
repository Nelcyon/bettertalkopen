<Window x:Class="Aac.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aac.App"
        Title="BetterTalk settings" Width="640" Height="820" MinWidth="480" MinHeight="500"
        FontFamily="Segoe UI" FontSize="16" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Open settings file" Padding="12,6" Margin="0,0,20,0" Click="OpenFile_Click"/>
            <Button Content="Cancel" Padding="16,6" Margin="10,0,0,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save and restart" Padding="16,6" Margin="10,0,0,0" IsDefault="True" FontWeight="SemiBold" Click="Save_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Foreground="#555" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="The app restarts to apply changes. The unfinished message and everything learned are kept."/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Voice"/>
                <!-- Downloaded voices are shaded green and have a delete button on their left (in the open list only). -->
                <ComboBox x:Name="Voice" SelectionChanged="Voice_SelectionChanged" MaxDropDownHeight="520" TextSearch.TextPath="Label">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Installed}" Value="True">
                                    <Setter Property="Background" Value="#DFF3E2"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Margin" Value="0,8,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplateSelector>
                        <local:VoiceRowTemplates>
                            <local:VoiceRowTemplates.InList>
                                <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="&#x1F5D1;" Padding="6,0" Margin="0,0,8,0" Focusable="False"
                                        ToolTip="Delete this voice's download from the computer"
                                        PreviewMouseLeftButtonDown="DeleteVoice_PreviewMouseDown">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Installed}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                            </local:VoiceRowTemplates.InList>
                            <local:VoiceRowTemplates.Chosen>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </local:VoiceRowTemplates.Chosen>
                        </local:VoiceRowTemplates>
                    </ComboBox.ItemTemplateSelector>
                </ComboBox>
                <DockPanel Margin="0,6,0,0" LastChildFill="True">
                    <Button x:Name="VoiceTest" DockPanel.Dock="Left" Content="&#x25B6; Hear it again" Padding="12,4" Click="VoiceTest_Click"/>
                    <ProgressBar x:Name="VoiceProgress" Height="12" Margin="10,0,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="VoiceInfo" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Speaking speed: "/><Run Text="{Binding Value, ElementName=Rate, StringFormat=N0}"/>
                </TextBlock>
                <Slider x:Name="Rate" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Volume: "/><Run Text="{Binding Value, ElementName=Volume, StringFormat=N0}"/>
                </TextBlock>
                <Slider x:Name="Volume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Text size: "/><Run Text="{Binding Value, ElementName=TextSize, StringFormat=N0}"/>
                </TextBlock>
                <Slider x:Name="TextSize" Minimum="16" Maximum="60" TickFrequency="2" IsSnapToTickEnabled="True"/>

                <TextBlock Style="{StaticResource Label}" Text="When to speak"/>
                <ComboBox x:Name="SpeakWhen">
                    <ComboBoxItem Content="When I press Speak (reads the whole message)" Tag="Message"/>
                    <ComboBoxItem Content="Each word as I finish it (Speak still reads the whole message)" Tag="EachWord"/>
                </ComboBox>

                <TextBlock Style="{StaticResource Label}" Text="Selection highlight (pressed keys always flash)"/>
                <ComboBox x:Name="Highlight">
                    <ComboBoxItem Content="While using arrow keys or switches" Tag="WhileUsingKeys"/>
                    <ComboBoxItem Content="Always" Tag="Always"/>
                    <ComboBoxItem Content="Never (flash only)" Tag="Never"/>
                </ComboBox>

                <TextBlock Style="{StaticResource Label}" Text="Itch doll keys (click a box, then press the key or QuadStick button)"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Turn left " VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyTurnLeft" Grid.Column="1" Margin="4" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                    <TextBlock Text="  Turn right " Grid.Column="2" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyTurnRight" Grid.Column="3" Margin="4" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                    <TextBlock Text="Closer " Grid.Row="1" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyCloser" Grid.Row="1" Grid.Column="1" Margin="4" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                    <TextBlock Text="  Farther " Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyFarther" Grid.Row="1" Grid.Column="3" Margin="4" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                    <TextBlock Text="Move up " Grid.Row="2" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyMoveUp" Grid.Row="2" Grid.Column="1" Margin="4" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                    <TextBlock Text="  Move down " Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyMoveDown" Grid.Row="2" Grid.Column="3" Margin="4" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                    <TextBlock Text="Move left " Grid.Row="3" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyMoveLeft" Grid.Row="3" Grid.Column="1" Margin="4" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                    <TextBlock Text="  Move right " Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyMoveRight" Grid.Row="3" Grid.Column="3" Margin="4" IsReadOnly="True" PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                </Grid>
                <TextBlock Text="The mouse also works: left-drag to turn and tilt the doll, right-drag to move it, the wheel zooms in on whatever is under the pointer, and a left click marks the spot."
                           Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Style="{StaticResource Label}" Text="Open from the top-left corner of the screen"/>
                <ComboBox x:Name="Corner">
                    <ComboBoxItem Content="With a click in the corner" Tag="Click"/>
                    <ComboBoxItem Content="By resting the mouse in the corner" Tag="Rest"/>
                    <ComboBoxItem Content="Off" Tag="Off"/>
                </ComboBox>
                <CheckBox x:Name="AutoHide" Content="Hide when the mouse leaves the window (the Hide key is then not shown)"/>
                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Seconds before hiding: "/><Run Text="{Binding Value, ElementName=AutoHideSeconds, StringFormat=N0}"/>
                </TextBlock>
                <Slider x:Name="AutoHideSeconds" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                        IsEnabled="{Binding IsChecked, ElementName=AutoHide}"/>
                <CheckBox x:Name="LockSize" Content="Lock the window size (no resizing or maximizing)"/>
                <CheckBox x:Name="StartHidden" Content="Start hidden in the taskbar tray"/>
                <CheckBox x:Name="AlwaysOnTop" Content="Keep the window on top of other programs"/>
                <CheckBox x:Name="QuickSpeak" Content="Quick and urgent phrases speak with one selection"/>
                <CheckBox x:Name="Learn" Content="Learn from what is said (stays on this computer, encrypted)"/>

                <Button Content="Edit buttons on screen (tap a button to change its words)…" Margin="0,16,0,0" Padding="12,8"
                        HorizontalAlignment="Left" Click="EditButtons_Click"/>

                <TextBlock Style="{StaticResource Label}" Text="Urgent phrases, always shown at the top (one per line)"/>
                <TextBox x:Name="Pinned" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Style="{StaticResource Label}" Text="Quick phrases on the Quick page (one per line)"/>
                <TextBox x:Name="Quick" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
